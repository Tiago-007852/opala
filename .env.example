# =====================================================================
# OPALA — variáveis de ambiente
# Copie este ficheiro para .env (que está no .gitignore) e preencha.
# Nunca faça commit do .env.
# =====================================================================

# ---------------------------------------------------------------- BANCO
# Connection string do Neon (dashboard → Connect → "Pooled connection").
# Formato: postgresql://utilizador:palavra-passe@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Ligação ao Neon sem verificar a cadeia de certificados.
# Só mude para "false" se o TLS falhar por CA local desatualizada.
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# Máximo de conexões do pool (Neon pooled aguenta bem 10).
DATABASE_POOL_MAX="10"

# ----------------------------------------------------------- SEGURANÇA
# Validade de cada sessão do painel admin, em horas.
ADMIN_SESSION_TTL_HOURS="8"

# Validade da sessão das contas de cliente do site, em dias (1 a 365).
CUSTOMER_SESSION_DAYS="30"

# Usada apenas por `npm run admin:create` para não gerar palavra-passe
# aleatória. Deixe vazia para gerar automaticamente; não a guarde no repo.
# ADMIN_PASSWORD=""

# ------------------------------------------------------------------ IA
# GEMINI_API_KEY: necessária para o assistente Gemini.
# Sem ela, o assistente responde em modo local (fallback).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL onde a app está hospedada (links e callbacks).
APP_URL="MY_APP_URL"
